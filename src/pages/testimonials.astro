---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import { business } from '../data/business.js';
import { testimonials, aggregateRating } from '../data/testimonials.js';

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": business.name,
  "url": "https://supplementestimator.com/testimonials",
  "telephone": business.telephone,
  "logo": business.logo,
  "description": "Real reviews from roofing, GC, and restoration contractors who use Precision Estimating and Supplements for Xactimate estimates, supplements, and carrier negotiations.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": aggregateRating.ratingValue,
    "bestRating": aggregateRating.bestRating,
    "reviewCount": aggregateRating.reviewCount
  },
  "review": testimonials.map((t) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": t.name },
    "reviewRating": { "@type": "Rating", "ratingValue": t.rating, "bestRating": 5 },
    "reviewBody": t.text
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://supplementestimator.com" },
    { "@type": "ListItem", "position": 2, "name": "Testimonials", "item": "https://supplementestimator.com/testimonials" }
  ]
};
---

<Layout
  title="Testimonials | Precision Estimating and Supplements"
  description="See what roofing contractors, GCs, and restoration companies say about working with Precision Estimating and Supplements. 5.0 stars from 9 Google reviews."
  canonical="https://supplementestimator.com/testimonials"
  schema={schema}
>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="px-5 md:px-8 pt-32 pb-16 bg-secondary relative overflow-hidden">
    <div class="hero-glow absolute inset-0 pointer-events-none"></div>
    <div class="max-w-page mx-auto text-center relative z-10">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">
        What Contractors Say About Working With Us
      </h1>
      <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto">
        Real feedback from roofing contractors, GCs, and restoration companies who trust us with their claims.
      </p>
    </div>
  </section>

  <Testimonials heading="9 Reviews, 5.0 Stars" layout="grid" />

  <CTA />
</Layout>
