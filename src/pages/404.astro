---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Precision Estimating and Supplements"
  description="The page you're looking for doesn't exist. Explore our estimating services or find your state."
  robots="noindex, follow"
>
  <section class="min-h-[70vh] flex items-center justify-center px-5 md:px-8 py-32 bg-primary text-center">
    <div class="max-w-xl mx-auto">
      <div class="text-accent-teal font-heading text-sm font-semibold tracking-[0.1em] uppercase mb-4">404</div>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">
        We Couldn't Find That Page
      </h1>
      <p class="text-slate-400 text-lg leading-relaxed mb-10">
        The page you're looking for may have been moved or no longer exists. Here are a few places to get back on track:
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Back to Home
        </a>
        <a href="/services" class="inline-flex items-center justify-center gap-2 bg-surface border border-accent/20 hover:border-accent/50 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          View Services
        </a>
        <a href="/locations" class="inline-flex items-center justify-center gap-2 bg-surface border border-accent/20 hover:border-accent/50 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Find Your State
        </a>
      </div>
    </div>
  </section>
</Layout>
