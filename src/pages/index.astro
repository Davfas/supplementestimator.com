---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import WhiteLabel from '../components/WhiteLabel.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import { business } from '../data/business.js';
import { testimonials, aggregateRating } from '../data/testimonials.js';

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": business.name,
  "url": business.url,
  "telephone": business.telephone,
  "email": business.email,
  "logo": business.logo,
  "image": business.image,
  "description": "Precision Estimating and Supplements writes Xactimate estimates, supplements, and negotiates with carriers so contractors get paid what they're owed. 7,000+ claims. Nationwide.",
  "areaServed": { "@type": "Country", "name": "United States" },
  "serviceType": [
    "Xactimate Estimate Writing",
    "Supplement Writing",
    "Insurance Carrier Negotiations",
    "Final Invoice Submission",
    "Consulting & Training",
    "White Label Estimating Services"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": aggregateRating.ratingValue,
    "bestRating": aggregateRating.bestRating,
    "reviewCount": aggregateRating.reviewCount
  },
  "review": testimonials.map((t) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": t.name },
    "reviewRating": { "@type": "Rating", "ratingValue": t.rating, "bestRating": 5 },
    "reviewBody": t.text
  }))
};
---

<Layout schema={schema}>
  <Hero />
  <TrustBar />
  <Services />
  <Process />
  <WhiteLabel />
  <About />
  <Testimonials limit={6} showViewAll={true} autoplay={true} />
  <CTA />
  <div class="px-5 md:px-8 py-6 border-t border-accent/10 max-w-page mx-auto">
    <p class="text-slate-500 text-xs leading-relaxed">
      <span class="font-semibold text-slate-400">PA DISCLOSURE:</span>

Precision Estimating & Supplements is not a public adjusting firm and does not provide public adjusting services.

Precision Estimating & Supplements works exclusively on behalf of restoration contractors and provides estimating, supplement preparation, documentation support, and claim-related consulting services to its contractor clients.

At no time does Precision Estimating & Supplements represent insureds in the presentation, negotiation, adjustment, settlement, or collection of insurance claims. We do not interpret insurance policies, provide coverage opinions, advise insureds regarding their rights under an insurance policy, or advocate on behalf of insureds in claim disputes.

Except as necessary for administrative matters, such as coordinating access or collecting payment of a contractor's invoice, Precision Estimating & Supplements does not communicate directly with insureds regarding claim handling, claim valuation, policy benefits, or claim settlement matters.

All services are provided solely to the contractor client.

    </p>
  </div>
</Layout>
